  "hosts": {
    "claude-code": {
      "tool": "claude",
      "providers": [
        "anthropic"
      ],
      "agentFiles": ".claude/agents/*.md (model: alias, full id or inherit; per-call model on the Agent tool)"
    },
    "codex": {
      "tool": "codex",
      "providers": [
        "openai"
      ],
      "agentFiles": ".codex/agents/*.toml (model, model_reasoning_effort); agents inherit the session provider"
    },
    "opencode": {
      "tool": "opencode",
      "providers": [
        "*"
      ],
      "agentFiles": ".opencode/agents/*.md (model: provider/model-id); any configured provider per agent"
    },
    "cursor": {
      "tool": "cursor",
      "providers": [
        "*"
      ],
      "agentFiles": ".cursor/agents/*.md (model: inherit or a Cursor model id); also reads .claude/agents"
    },
    "antigravity": {
      "tool": "antigravity",
      "providers": [
        "google"
      ],
      "agentFiles": ".agents/agents/*.md (model: inherit, flash or pro only); Claude and other models are chosen in its UI"
    },
    "gemini": {
      "tool": "gemini",
      "providers": [
        "google"
      ],
      "agentFiles": ".gemini/agents/*.md (legacy Gemini CLI, replaced by Antigravity CLI for consumers)"
    },
    "windsurf": {
      "tool": "windsurf",
      "providers": [
        "*"
      ],
      "agentFiles": "Windsurf is now Devin Desktop; models are chosen in its UI (experimental .devin/agents files not written by the kit)"
    }
  }
}
